---
// Supports weights 100-900
import "@fontsource-variable/noto-serif-display";
// Supports weights 400-900
import "@fontsource-variable/playfair-display";
import { ViewTransitions } from "astro:transitions";
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Astro description" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <script
      async
      src="https://sim-analytics.duckdns.org/script.js"
      data-website-id="05abea98-abd4-4472-9226-536d5c04db01"></script>
    <ViewTransitions fallback="swap" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="nav-wrap">
        <a class="logo" href="/">Jen Tyler</a>
        <nav class="main-nav">
          <a href="/bio">Bio</a>
          <a href="/cv">CV</a>
          <a href="/portfolio">Portfolio</a>
        </nav>
      </div>
    </header>

    <main class="site-main">
      <slot />
    </main>
  </body>
</html>

<style is:global>
  root {
    --cream: #faf9f6;
  }

  html {
    background-color: var(--cream);
    font-family: "Playfair Display Variable", "Times New Roman", Times, serif;
  }
  .pushable {
    font-family: inherit;
    margin-top: 1rem;
    margin-bottom: 1rem;
  }
  code {
    font-family:
      Menlo,
      Monaco,
      Lucida Console,
      Liberation Mono,
      DejaVu Sans Mono,
      Bitstream Vera Sans Mono,
      Courier New,
      monospace;
  }
  /* Header / navigation for site-wide links */
  .site-header {
    padding: 1rem 0.75rem;
    background: linear-gradient(
      90deg,
      rgba(36, 37, 41, 0.95),
      rgba(28, 28, 32, 0.95)
    );
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
  }
  /* Ensure header spans full width even when body is a flex container */
  .site-header {
    width: 100%;
    align-self: stretch;
    left: 0;
    right: 0;
  }
  .nav-wrap {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .logo {
    font-weight: 700;
    color: #e0e0ff;
    text-decoration: none;
    font-size: 1.05rem;
  }
  .main-nav a {
    color: #cfd6ff;
    text-decoration: none;
    margin-left: 1rem;
    transition:
      color 0.2s ease,
      transform 0.15s ease;
  }
  .main-nav a:hover {
    color: #ff2a6d;
    transform: translateY(-1px);
  }
  .site-main {
    max-width: 1100px;
    margin: 1.25rem auto;
    padding: 0 0.75rem;
  }
</style>
