---
import Layout from "../layouts/Layout.astro";
import "../styles.css";
import { Image } from "astro:assets";
import profile from "../assets/jenprofile.jpeg";
// project images moved to Portfolio page
import { ViewTransitions } from "astro:transitions";
import "@fontsource-variable/space-grotesk";

// projects list moved to `src/pages/portfolio.astro`
---

<Layout title="Portfolio Page">
  <ViewTransitions />

  <div class="container home-hero">
    <!-- Decorative animated background blobs (purely visual, behind the profile card)
         Wrapped so we can move each wrapper via JS (mouse/touch) while the inner
         .blob element keeps its existing animation. -->
    <div class="bg-anim" aria-hidden="true">
      <div class="blob-wrap w1"><span class="blob b1"></span></div>
      <div class="blob-wrap w2"><span class="blob b2"></span></div>
      <div class="blob-wrap w3"><span class="blob b3"></span></div>
      <div class="blob-wrap w4"><span class="blob b4"></span></div>
    </div>
    <div class="profile">
      <div class="profile-media">
        <Image class="profile-image" src={profile} alt="me" />
      </div>
      <div class="meta">
        <h1>Hi, I'm Jen!</h1>
        <p class="bio">
          I'm an aspiring web and game developer currently studying Digital
          Media at UCF. I specialize in spooky projects and unique web
          experiences. Check out the other pages for more info on me and the
          projects I've made!
        </p>
        <div class="icons">
          <a
            href="https://docs.google.com/document/d/1y6KogTM-77zl3HpO0swl2cJmguuPq9JP/edit?usp=sharing&ouid=112253065582950476881&rtpof=true&sd=true"
            target="_blank"><span class="mdi--resume icon-image"></span></a
          >
          <a href="https://linkedin.com/in/jen-tyler" target="_blank"
            ><span class="mdi--linkedin icon-image"></span></a
          >
          <a href="https://github.com/chickenjenders" target="_blank"
            ><span class="mdi--github icon-image"></span></a
          >
          <a href="mailto: jgtyler99@gmail.com" target="_blank"
            ><span class="mdi--email icon-image"></span></a
          >
        </div>
      </div>
    </div>
  </div>
  <!-- background and hero styles moved to src/styles.css -->

  <!-- Mouse-follow script for the blobs (lava-lamp style) -->
  <script type="module">
    // Respect prefers-reduced-motion
    if (
      !window.matchMedia ||
      !window.matchMedia("(prefers-reduced-motion: reduce)").matches
    ) {
      const wrappers = Array.from(
        document.querySelectorAll(".bg-anim .blob-wrap")
      );
      if (wrappers.length) {
        let target = { x: 0, y: 0 };
        let current = { x: 0, y: 0 };
        let rafId = null;

        function onMove(e) {
          const clientX = e.touches ? e.touches[0].clientX : e.clientX;
          const clientY = e.touches ? e.touches[0].clientY : e.clientY;
          const cx = window.innerWidth / 2;
          const cy = window.innerHeight / 2;
          // Normalized -1..1
          target.x = (clientX - cx) / cx;
          target.y = (clientY - cy) / cy;
          start();
        }

        function lerp(a, b, t) {
          return a + (b - a) * t;
        }

        function update() {
          current.x = lerp(current.x, target.x, 0.08);
          current.y = lerp(current.y, target.y, 0.08);
          wrappers.forEach((w, i) => {
            // Different strength per blob (px)
            const strengths = [48, 36, 24, 16];
            const s = strengths[i] || 20;
            const tx = Math.round(current.x * s);
            const ty = Math.round(current.y * s);
            w.style.transform = `translate3d(${tx}px, ${ty}px, 0)`;
          });
          rafId = requestAnimationFrame(update);
        }

        function start() {
          if (!rafId) rafId = requestAnimationFrame(update);
        }

        function stop() {
          if (rafId) {
            cancelAnimationFrame(rafId);
            rafId = null;
          }
        }

        window.addEventListener("mousemove", onMove, { passive: true });
        window.addEventListener("touchmove", onMove, { passive: true });
        window.addEventListener(
          "mouseleave",
          () => {
            target.x = 0;
            target.y = 0;
            start();
          },
          { passive: true }
        );
      }
    }
  </script>
</Layout>
