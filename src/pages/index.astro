---
import Layout from "../layouts/Layout.astro";
import "../styles.css";
import { Image } from "astro:assets";
import profile from "../assets/jenprofile.jpeg";
// project images moved to Portfolio page
import { ViewTransitions } from "astro:transitions";
import "@fontsource-variable/space-grotesk";

// projects list moved to `src/pages/portfolio.astro`
---

<Layout title="Portfolio Page">
  <ViewTransitions />

  <div class="container home-hero">
    <div class="profile">
      <div class="profile-media">
        <Image class="profile-image" src={profile} alt="me" />
      </div>
      <div class="meta">
        <h1>Hi, I'm Jen!</h1>
        <p class="bio">
          I'm an aspiring web and game developer currently studying Digital
          Media at UCF. I specialize in spooky projects and unique web
          experiences!
        </p>
        <div class="icons">
          <a
            href="https://docs.google.com/document/d/1y6KogTM-77zl3HpO0swl2cJmguuPq9JP/edit?usp=sharing&ouid=112253065582950476881&rtpof=true&sd=true"
            target="_blank"><span class="mdi--resume icon-image"></span></a
          >
          <a href="https://linkedin.com/in/jen-tyler" target="_blank"
            ><span class="mdi--linkedin icon-image"></span></a
          >
          <a href="https://github.com/chickenjenders" target="_blank"
            ><span class="mdi--github icon-image"></span></a
          >
          <a href="mailto: jgtyler99@gmail.com" target="_blank"
            ><span class="mdi--email icon-image"></span></a
          >
        </div>
        <div class="cta-row">
          <a class="btn" href="/portfolio">See Portfolio</a>
          <a class="btn" href="/bio">About / Bio</a>
        </div>
      </div>
    </div>
  </div>
  <style>
    /* Make the home profile card dominant and nearly fullscreen */
    .home-hero {
      min-height: calc(100vh - 140px);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 2rem 0;
      background: linear-gradient(
        180deg,
        rgba(18, 18, 22, 0.9),
        rgba(20, 18, 26, 0.95)
      );
    }
    .home-hero .profile {
      width: min(980px, 94%);
      background: linear-gradient(
        135deg,
        rgba(28, 24, 36, 0.9),
        rgba(22, 20, 30, 0.85)
      );
      padding: 2rem;
      border-radius: 14px;
      box-shadow: 0 12px 40px rgba(0, 0, 0, 0.6);
      display: flex;
      gap: 1.5rem;
      align-items: center;
    }
    .profile-image {
      height: 220px;
      width: 220px;
      border-radius: 12px;
      object-fit: cover;
      flex-shrink: 0;
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.6);
      border: 1px solid rgba(255, 255, 255, 0.03);
    }
    .profile > h1 {
      font-size: 2.25rem;
      margin: 0 0 0.25rem 0;
    }
    .profile .bio {
      margin: 0 0 1rem 0;
      font-size: 1.05rem;
      opacity: 0.95;
    }
    .profile .meta {
      display: flex;
      flex-direction: column;
    }
    .icons {
      margin-top: 0.5rem;
      display: flex;
      gap: 12px;
    }
    .icons a {
      color: inherit;
    }
    .cta-row {
      margin-top: 1rem;
      display: flex;
      gap: 0.75rem;
    }
    .btn {
      padding: 0.5rem 0.9rem;
      border-radius: 8px;
      background: rgba(255, 255, 255, 0.03);
      color: #e6e8ff;
      text-decoration: none;
      border: 1px solid rgba(255, 255, 255, 0.03);
      transition:
        transform 0.12s ease,
        background 0.12s ease;
    }
    .btn:hover {
      transform: translateY(-3px);
      background: rgba(255, 42, 109, 0.08);
    }

    @media (max-width: 800px) {
      .home-hero .profile {
        flex-direction: column;
        padding: 1.25rem;
      }
      .profile-image {
        width: 160px;
        height: 160px;
      }
      .profile > h1 {
        font-size: 1.8rem;
      }
    }
  </style>
</Layout>
